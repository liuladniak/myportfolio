---
type Zone = { x: number; y: number; w: number; h: number; label: string };
type Node = { x: number; y: number; w: number; h: number; title: string; sub?: string; lines?: string[]; kind?: 'plain' | 'main' | 'external' | 'infra' };
type Edge = { d: string; label?: string; lx?: number; ly?: number; anchor?: 'start' | 'middle'; both?: boolean; dashed?: boolean };
interface Props { width: number; height: number; zones: Zone[]; nodes: Node[]; edges: Edge[]; legend: string; label: string }
const { width, height, zones, nodes, edges, legend, label } = Astro.props;
---
<figure class="m-0">
  <div class="overflow-x-auto rounded-xl border border-line bg-white shadow-card" tabindex="0" aria-label="System diagram, scrollable">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label} class="block h-auto w-full min-w-[56rem] font-sans">
      <defs>
        <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 1 9 5 0 9z" class="fill-brand" /></marker>
      </defs>
      {zones.map((z) => (
        <g>
          <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="12" class="fill-[#f8f6ee] stroke-[#d9d4c3]" stroke-dasharray="3 4" />
          <text x={z.x + 16} y={z.y + 20} class="fill-muted font-mono" font-size="10.5" letter-spacing="1.4">{z.label.toUpperCase()}</text>
        </g>
      ))}
      {edges.map((e) => (
        <g>
          <path d={e.d} fill="none" class="stroke-brand" stroke-width="1.5" stroke-opacity={e.dashed ? 0.55 : 0.85} stroke-dasharray={e.dashed ? '5 4' : undefined} marker-end="url(#arr)" marker-start={e.both ? 'url(#arr)' : undefined} />
          {e.label && <text x={e.lx} y={e.ly} text-anchor={e.anchor ?? 'start'} font-size="11" class="fill-body font-mono [paint-order:stroke] stroke-white stroke-[5px]">{e.label}</text>}
        </g>
      ))}
      {nodes.map((n) => {
        const main = n.kind === 'main';
        return (
          <g>
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="9" class:list={[main ? 'fill-brand stroke-brand' : n.kind === 'infra' ? 'fill-[#f8f6ee] stroke-[#cdc7b3]' : 'fill-white stroke-[#cdc7b3]']} stroke-width="1.2" stroke-dasharray={n.kind === 'external' ? '4 3' : undefined} />
            <text x={n.x + 14} y={n.y + 25} font-size="14.5" font-weight="600" class:list={[main ? 'fill-white' : 'fill-ink']}>{n.title}</text>
            {n.sub && <text x={n.x + 14} y={n.y + 44} font-size="11.5" class:list={[main ? 'fill-[#e3dfce]' : 'fill-muted']}>{n.sub}</text>}
            {n.lines?.map((line, i) => <text x={n.x + 14} y={n.y + 76 + i * 22} font-size="12" class:list={[main ? 'fill-white' : 'fill-body']}>{line}</text>)}
          </g>
        );
      })}
      <text x="20" y={height - 12} font-size="11" class="fill-muted font-mono">{legend}</text>
    </svg>
  </div>
</figure>
