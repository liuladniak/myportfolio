---
interface Row { area: string; color: string; place: string }
interface Props { headers: string[]; rows: Row[] }
const { headers, rows } = Astro.props;
---
<div class="overflow-hidden rounded-xl border border-line bg-white text-[13.5px] shadow-card">
  <div class="mono-label hidden gap-6 border-b border-line bg-black/[0.02] px-5 py-2.5 text-muted md:grid md:grid-cols-[12rem_1fr]">
    {headers.map((h) => <span>{h}</span>)}
  </div>
  <ul class="m-0 list-none p-0">
    {rows.map((row) => (
      <li class="grid gap-x-6 gap-y-1.5 border-t border-line px-5 py-3.5 first:border-t-0 md:grid-cols-[12rem_1fr]">
        <p class="m-0 flex items-start gap-2 font-semibold"><i aria-hidden="true" class="mt-1.5 size-2 shrink-0 rounded-full" style={`background:${row.color}`}></i>{row.area}</p>
        <p class="m-0 max-w-[46rem] leading-relaxed text-body">{row.place}</p>
      </li>
    ))}
  </ul>
</div>