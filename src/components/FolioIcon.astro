---
interface Props { name: 'arrow-up-right' | 'arrow-left' | 'plus'; class?: string }
const { name, class: className } = Astro.props;
const paths = {
  'arrow-up-right': 'M7 17 17 7M7 7h10v10',
  'arrow-left': 'm12 19-7-7 7-7M19 12H5',
  plus: 'M5 12h14M12 5v14',
};
---
<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" class:list={['size-3.5', className]}><path d={paths[name]} /></svg>
