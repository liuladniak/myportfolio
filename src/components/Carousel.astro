---
import { getImage } from 'astro:assets';
import FramedPicture from './FramedPicture.astro';

interface Props {
  label: string;
  slides: { title: string; image: ImageMetadata; alt: string; portrait?: boolean }[];
}
const { label, slides } = Astro.props;
// Large versions for the lightbox (the inline pictures are cropped thumbnails).
const full = await Promise.all(slides.map((slide) => getImage({ src: slide.image, width: Math.min(slide.image.width, 1800), format: 'webp' })));
const lbBtn = 'absolute z-10 grid size-11 place-items-center rounded-full border border-white/25 bg-black/40 text-white backdrop-blur transition-colors hover:bg-black/70 disabled:opacity-30';
const sizes = '(min-width: 64rem) 34rem, (min-width: 40rem) 62vw, 88vw';
const arrow = 'size-4 fill-none stroke-current';
const round = 'inline-grid size-11 place-items-center rounded-full border border-line bg-white text-ink transition-colors hover:border-brand hover:text-brand disabled:cursor-default disabled:opacity-40 disabled:hover:border-line disabled:hover:text-ink';
---
<div data-carousel>
  <!-- Swipe, scroll or use the arrow keys without JavaScript; the buttons and dots below are added on top of that. -->
  <div
    data-track
    role="region"
    aria-roledescription="carousel"
    aria-label={label}
    tabindex="0"
    class="-mx-1 flex snap-x snap-mandatory gap-5 overflow-x-auto px-1 pb-1 outline-offset-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    {slides.map((slide, i) => (
      <figure data-slide role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} class="m-0 w-[88%] shrink-0 snap-start sm:w-[62%] lg:w-[54%]">
        <button type="button" data-open={i} aria-label={`Enlarge: ${slide.title}`} class="group relative block w-full cursor-zoom-in overflow-hidden rounded-[10px] border border-line bg-white p-0 text-left shadow-card">
          <div aria-hidden="true" class="flex gap-1.5 bg-[#dcd7c6] px-3 py-2.5">
            <i class="size-2 rounded-full bg-[#c6bfa9]"></i><i class="size-2 rounded-full bg-[#c6bfa9]"></i><i class="size-2 rounded-full bg-[#c6bfa9]"></i>
          </div>
          {slide.portrait ? (
            <div class="relative aspect-[16/10] bg-[#e7e3d6]">
              <FramedPicture src={slide.image} alt={slide.alt} ratio={[6, 13]} widths={[240, 360, 480]} sizes="14rem" position="top" class="absolute inset-y-4 left-1/2 -translate-x-1/2 rounded-md border border-line" />
            </div>
          ) : (
            <FramedPicture src={slide.image} alt={slide.alt} ratio={[16, 10]} widths={[480, 720, 960]} sizes={sizes} position="top" />
          )}
          <span aria-hidden="true" class="absolute bottom-3 right-3 grid size-9 place-items-center rounded-full bg-ink/75 text-white opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 max-sm:opacity-100">
            <svg viewBox="0 0 16 16" class="size-4 fill-none stroke-current" stroke-width="1.5" stroke-linecap="round"><path d="M9.500 2.500h4v4M6.500 13.500h-4v-4M13.500 2.500 9 7M2.500 13.500 7 9"/></svg>
          </span>
        </button>
        <figcaption class="mt-3 text-sm font-semibold">{slide.title}</figcaption>
      </figure>
    ))}
  </div>

  <div data-controls hidden class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p class="mono-label min-w-12 text-muted" aria-live="polite"><span data-current>1</span> / {slides.length}</p>
    <div class="flex items-center">
      {slides.map((slide, i) => (
        <button type="button" data-dot aria-label={`Show screen ${i + 1}: ${slide.title}`} class="group grid size-11 place-items-center">
          <span class="h-2 w-2 rounded-full bg-[#c6bfa9] transition-all group-hover:bg-[#8e8e93] group-aria-[current=true]:w-5 group-aria-[current=true]:bg-brand"></span>
        </button>
      ))}
    </div>
    <div class="flex gap-2">
      <button type="button" data-prev aria-label="Previous screen" class={round}>
        <svg aria-hidden="true" viewBox="0 0 16 16" class={arrow} stroke-width="1.6"><path d="M10 3 5 8l5 5" /></svg>
      </button>
      <button type="button" data-next aria-label="Next screen" class={round}>
        <svg aria-hidden="true" viewBox="0 0 16 16" class={arrow} stroke-width="1.6"><path d="m6 3 5 5-5 5" /></svg>
      </button>
    </div>
  </div>
<dialog data-lightbox aria-label={`${label}, enlarged`} class="m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-transparent p-0 text-white backdrop:bg-[#0c0f1d]/90 backdrop:backdrop-blur-sm open:flex">
  <div data-lbtrack class="flex h-full w-full snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {slides.map((slide, i) => (
      <figure data-lbslide class="m-0 flex h-full w-full shrink-0 snap-center snap-always flex-col items-center justify-center gap-3 px-4 pb-16 pt-16 sm:px-20">
        <img data-src={full[i].src} alt={slide.alt} width={full[i].attributes.width} height={full[i].attributes.height} decoding="async" class="min-h-0 max-h-full max-w-full rounded-md object-contain shadow-2xl" />
        <figcaption class="text-sm text-white/85">{slide.title}</figcaption>
      </figure>
    ))}
  </div>
  <button type="button" data-close aria-label="Close" class={`${lbBtn} right-4 top-4`}>
    <svg aria-hidden="true" viewBox="0 0 16 16" class={arrow} stroke-width="1.6" stroke-linecap="round"><path d="m3 3 10 10M13 3 3 13"/></svg>
  </button>
  <button type="button" data-lbprev aria-label="Previous screen" class={`${lbBtn} left-3 top-1/2 -translate-y-1/2 sm:left-5`}>
    <svg aria-hidden="true" viewBox="0 0 16 16" class={arrow} stroke-width="1.6"><path d="M10 3 5 8l5 5" /></svg>
  </button>
  <button type="button" data-lbnext aria-label="Next screen" class={`${lbBtn} right-3 top-1/2 -translate-y-1/2 sm:right-5`}>
    <svg aria-hidden="true" viewBox="0 0 16 16" class={arrow} stroke-width="1.6"><path d="m6 3 5 5-5 5" /></svg>
  </button>
  <p data-lbcount aria-live="polite" class="mono-label absolute left-1/2 top-6 -translate-x-1/2 text-white/80"></p>
</dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    if (!track || !controls) return;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const current = root.querySelector<HTMLElement>('[data-current]');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    controls.hidden = false;
    let index = 0;

    const go = (target: number) => {
      const i = Math.max(0, Math.min(slides.length - 1, target));
      const left = slides[i].getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
      track.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };

    const update = () => {
      const trackLeft = track.getBoundingClientRect().left;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      index = atEnd
        ? slides.length - 1
        : slides.reduce((best, slide, i) => (Math.abs(slide.getBoundingClientRect().left - trackLeft) < Math.abs(slides[best].getBoundingClientRect().left - trackLeft) ? i : best), 0);
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
      if (current) current.textContent = String(index + 1);
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    let frame = 0;
    track.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(update); }, { passive: true });
    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); go(index + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); go(index - 1); }
    });
    update();

    // Lightbox: a native modal <dialog> holding the same screens at full size in its own snap track.
    const dlg = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lbTrack = root.querySelector<HTMLElement>('[data-lbtrack]');
    if (!dlg || !lbTrack) return;
    const lbSlides = [...dlg.querySelectorAll<HTMLElement>('[data-lbslide]')];
    const lbPrev = dlg.querySelector<HTMLButtonElement>('[data-lbprev]');
    const lbNext = dlg.querySelector<HTMLButtonElement>('[data-lbnext]');
    const count = dlg.querySelector<HTMLElement>('[data-lbcount]');
    let lbIndex = 0;
    const load = (i: number) => lbSlides[i]?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => { img.src = img.dataset.src!; img.removeAttribute('data-src'); });
    const lbGo = (target: number, instant = false) => {
      const i = Math.max(0, Math.min(lbSlides.length - 1, target));
      lbTrack.scrollTo({ left: i * lbTrack.clientWidth, behavior: instant || reduceMotion.matches ? 'auto' : 'smooth' });
    };
    const lbUpdate = () => {
      lbIndex = Math.round(lbTrack.scrollLeft / lbTrack.clientWidth);
      [lbIndex - 1, lbIndex, lbIndex + 1].forEach(load);
      if (count) count.textContent = `${lbIndex + 1} / ${lbSlides.length}`;
      if (lbPrev) lbPrev.disabled = lbIndex === 0;
      if (lbNext) lbNext.disabled = lbIndex === lbSlides.length - 1;
    };
    let lbFrame = 0;
    lbTrack.addEventListener('scroll', () => { cancelAnimationFrame(lbFrame); lbFrame = requestAnimationFrame(lbUpdate); }, { passive: true });
    lbPrev?.addEventListener('click', () => lbGo(lbIndex - 1));
    lbNext?.addEventListener('click', () => lbGo(lbIndex + 1));
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    // Any click that is not on a picture, caption or button closes it (the dark overlay, the empty space around a slide).
    dlg.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('img, button, figcaption')) dlg.close(); });
    // Arrow keys are handled on the document while it is open, so they work wherever focus happens to be (Safari does not focus clicked buttons).
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); lbGo(lbIndex + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); lbGo(lbIndex - 1); }
    };
    let opener: HTMLElement | null = null;
    dlg.addEventListener('close', () => { document.removeEventListener('keydown', onKey); document.documentElement.style.overflow = ''; opener?.focus(); go(lbIndex); });
    root.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => btn.addEventListener('click', () => {
      opener = btn;
      document.documentElement.style.overflow = 'hidden';
      dlg.showModal();
      document.addEventListener('keydown', onKey);
      lbGo(Number(btn.dataset.open), true);
      lbUpdate();
      dlg.querySelector<HTMLButtonElement>('[data-close]')?.focus();
    }));
  });
</script>
