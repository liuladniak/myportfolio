---
interface Props { value: string; label: string; showText?: boolean; class?: string }
const { value, label, showText = false, class: className } = Astro.props;
---
<!-- Hidden until the script below runs, so it never shows as a dead control without JavaScript. -->
<button type="button" hidden data-copy={value} aria-label={label} class:list={['group inline-flex min-h-11 min-w-11 items-center justify-center gap-1.5 px-3 text-[13px] font-medium transition-colors', className]}>
  <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 fill-none stroke-current group-data-[copied]:hidden" stroke-width="1.4"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3v5.5A1.5 1.5 0 0 0 3.5 10H4" /></svg>
  <svg aria-hidden="true" viewBox="0 0 16 16" class="hidden size-4 fill-none stroke-current group-data-[copied]:block" stroke-width="1.6"><path d="m3 8.5 3.2 3L13 4.5" /></svg>
  {showText && <span class="group-data-[copied]:hidden">Copy</span>}
  {showText && <span class="hidden group-data-[copied]:inline">Copied</span>}
</button>
<script>
  const live = document.createElement('p');
  live.setAttribute('role', 'status');
  live.className = 'sr-only';
  document.body.append(live);

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const field = document.createElement('textarea');
      field.value = text;
      field.setAttribute('readonly', '');
      field.style.cssText = 'position:fixed;opacity:0';
      document.body.append(field);
      field.select();
      const ok = document.execCommand('copy');
      field.remove();
      return ok;
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.hidden = false;
    let timer: number;
    button.addEventListener('click', async () => {
      const ok = await copy(button.dataset.copy ?? '');
      live.textContent = ok ? `${(button.getAttribute('aria-label') ?? '').replace(/^Copy /, '')} copied` : 'Copy failed';
      if (!ok) return;
      button.dataset.copied = '';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.copied;
        live.textContent = '';
      }, 2000);
    });
  });
</script>
