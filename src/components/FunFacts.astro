---
interface Props { items: { icon: 'users' | 'globe' | 'clock' | 'book' | 'compass'; title: string; note: string }[] }
const { items } = Astro.props;
// Small line icons, drawn at 24px with the current text colour.
const icons = {
  users: '<circle cx="9" cy="8" r="3.500"/><path d="M2.500 20c0-3.600 2.900-6 6.500-6s6.500 2.400 6.500 6M16 4.800a3.500 3.500 0 0 1 0 6.400M18.500 14.400c1.900.8 3 2.700 3 5.600"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.500 2"/>',
  book: '<path d="M4 5.500A2.500 2.500 0 0 1 6.500 3H20v15H6.500A2.500 2.500 0 0 0 4 20.500zM4 20.500A2.500 2.500 0 0 0 6.500 23H20v-5"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
};
---
<ul class="m-0 mt-3 grid list-none gap-x-8 gap-y-8 p-0 sm:grid-cols-2 lg:grid-cols-4">
  {items.map((item) => (
    <li>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="mb-4 size-7 fill-none stroke-brand" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[item.icon]} />
      <p class="m-0 mb-1 text-base font-semibold leading-snug tracking-tight text-ink">{item.title}</p>
      <p class="m-0 text-[13px] leading-snug text-muted">{item.note}</p>
    </li>
  ))}
</ul>
