---
interface Props { href: string; variant?: 'primary' | 'secondary'; size?: 'md' | 'lg'; external?: boolean; download?: boolean }
const { href, variant = 'primary', size = 'md', external = false, download = false } = Astro.props;
const styles = {
  primary: 'border-brand bg-brand text-white shadow-[0_1px_2px_rgb(30_85_109/0.3),0_8px_20px_rgb(30_85_109/0.2)] hover:bg-brand-deep',
  secondary: 'border-[#d0cab6] bg-white text-ink hover:border-[#8e8e93]',
};
const sizes = { md: 'min-h-11 px-5 text-sm', lg: 'min-h-12 px-6 text-[0.9375rem]' };
---
<a href={href} download={download || undefined} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined} class:list={['inline-flex items-center rounded-[9px] border font-medium no-underline transition-colors', sizes[size], styles[variant]]}><slot /></a>
