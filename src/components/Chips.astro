---
interface Props { items: string[]; planned?: boolean; inProgress?: boolean }
const { items, planned = false, inProgress = false } = Astro.props;
---
<ul class="flex flex-wrap gap-1.5">
  {items.map((item) => (
    <li class:list={['rounded-md border px-2.5 py-0.5 text-[13px]', planned ? 'border-dashed border-[#b8b09a] bg-transparent text-muted' : 'border-line bg-(--chip-bg)', inProgress && 'flex items-center gap-1.5']}>
      {inProgress && <i aria-hidden="true" class="size-1.5 rounded-full bg-[#ff9500]"></i>}{item}
    </li>
  ))}
</ul>
