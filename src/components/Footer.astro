---
import type { ProjectPage } from '../data/types';
import Button from './Button.astro';

interface Props { project: ProjectPage }
const { project } = Astro.props;
const { footer, links } = project;
---
<footer class="bg-(--page-bg)">
  <div class="wrap pb-[max(3rem,env(safe-area-inset-bottom))] pt-14">
    <h2 class="heading mb-3">{footer.title}</h2>
    <p class="mb-6 text-muted">{footer.text}</p>
    <div class="flex flex-wrap items-center gap-3">
      {links.actions.map((action, i) => <Button href={action.href} variant={i === 0 ? 'primary' : 'secondary'}>{action.label}</Button>)}
      <a href="/projects/citygo" class="px-2 py-3 hover:underline">← Back to CityGo</a>
    </div>
  </div>
</footer>
