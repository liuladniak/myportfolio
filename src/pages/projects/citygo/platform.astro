---
import Architecture from '../../../components/Architecture.astro';
import Chapter from '../../../components/Chapter.astro';
import Decisions from '../../../components/Decisions.astro';
import Engineering from '../../../components/Engineering.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import Roadmap from '../../../components/Roadmap.astro';
import Screens from '../../../components/Screens.astro';
import Story from '../../../components/Story.astro';
import Base from '../../../layouts/Base.astro';
import { platform } from '../../../data/platform';
---
<Base title={platform.title} description={platform.summary}>
  <Hero project={platform} />
  <main id="main">
    <Screens project={platform} />
    <Story story={platform.story} kicker={platform.sections.story.kicker} id="api" />
    {platform.chapters?.map((chapter) => <Chapter chapter={chapter} />)}
    {platform.decisions && <Decisions decisions={platform.decisions} />}
    <Architecture project={platform} />
    <Engineering project={platform} />
    <Roadmap project={platform} />
  </main>
  <Footer project={platform} />
</Base>
