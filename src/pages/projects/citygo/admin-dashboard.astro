---
import Architecture from '../../../components/Architecture.astro';
import Chapter from '../../../components/Chapter.astro';
import Decisions from '../../../components/Decisions.astro';
import Engineering from '../../../components/Engineering.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import Roadmap from '../../../components/Roadmap.astro';
import Screens from '../../../components/Screens.astro';
import Story from '../../../components/Story.astro';
import Base from '../../../layouts/Base.astro';
import { admin } from '../../../data/admin-dashboard';
---
<Base title={admin.title} description={admin.summary}>
  <Hero project={admin} />
  <main id="main">
    <Screens project={admin} />
    <Story story={admin.story} kicker={admin.sections.story.kicker} id="story" />
    {admin.decisions && <Decisions decisions={admin.decisions} />}
    {admin.chapters?.map((chapter) => <Chapter chapter={chapter} />)}
    <Architecture project={admin} />
    <Engineering project={admin} />
    <Roadmap project={admin} />
  </main>
  <Footer project={admin} />
</Base>
