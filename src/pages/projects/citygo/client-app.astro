---
import Architecture from '../../../components/Architecture.astro';
import Chapter from '../../../components/Chapter.astro';
import Decisions from '../../../components/Decisions.astro';
import Engineering from '../../../components/Engineering.astro';
import Footer from '../../../components/Footer.astro';
import Hero from '../../../components/Hero.astro';
import Roadmap from '../../../components/Roadmap.astro';
import Screens from '../../../components/Screens.astro';
import Story from '../../../components/Story.astro';
import Base from '../../../layouts/Base.astro';
import { project } from '../../../data/project';
---
<Base title={project.title} description={project.summary}>
  <Hero project={project} />
  <main id="main">
    <Screens project={project} />
    <Story story={project.story} kicker={project.sections.story.kicker} id="story" />
    {project.decisions && <Decisions decisions={project.decisions} />}
    {project.chapters?.map((chapter) => <Chapter chapter={chapter} />)}
    <Architecture project={project} />
    <Engineering project={project} />
    <Roadmap project={project} />
  </main>
  <Footer project={project} />
</Base>
